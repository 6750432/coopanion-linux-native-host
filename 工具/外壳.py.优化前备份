from PySide6.QtWidgets import QApplication, QWidget

# ── 参数 ──────────────────────────────────────────────────────────────
PET_URL = ""
PARENT_PID = 0
for i, a in enumerate(sys.argv):
    if a.startswith("--pet-url="):
        PET_URL = a.split("=", 1)[1]
    elif a.startswith("--parent-pid="):
        try:
